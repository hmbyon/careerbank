# Postgres connection string (Render/Neon/Supabase). Leave unset to use a local
# SQLite file (./careerbank.db) for local development.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign JWTs. REQUIRED in production — if unset, a random secret is
# generated at process startup for local-dev convenience only (tokens won't survive
# a restart, and won't be valid across multiple instances).
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini API key. Get a free key at https://aistudio.google.com/apikey
# If unset, all AI features fall back to non-AI logic (canned questions, keyword
# matching, template drafts) so the app still runs and works without one.
GEMINI_API_KEY=

# Gemini model name.
GEMINI_MODEL=gemini-2.0-flash

# Origin allowed by CORS (the deployed/local frontend URL).
FRONTEND_URL=http://localhost:3000

# Optional: JWT access token lifetime in minutes (default 1440 = 24h).
JWT_EXPIRE_MINUTES=1440
